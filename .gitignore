# Python
.venv/
__pycache__/
*.pyc

# Data written by the storage nodes (the folders themselves are kept)
data/*/*
!data/*/.gitkeep

# Generated test datasets (the scripts that create them are committed)
datasets/

# Report building
report-build/out-*/
~$*

# Large generated sample (created by the commands in README)
examples/sample.bin

# Rendered report images (regenerated by the scripts in report-build/tools)
report-build/placeholders/
report-build/flowcharts/*.html
report-build/flowcharts/*.size
